# Application
APP_NAME=agentic-finance-research
APP_ENVIRONMENT=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database / Supabase PostgreSQL
# Use the direct PostgreSQL connection string supplied by Supabase.
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose or commit this value.
SUPABASE_SERVICE_ROLE_KEY=
# Dimension expected from the embedding provider selected in a later phase.
EMBEDDING_DIMENSION=1536

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-finance-research-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Initial Groq-compatible LLM provider configuration
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
